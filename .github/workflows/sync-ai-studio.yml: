name: Sync AI Studio Content

on:
  schedule:
    - cron: '*/30 * * * *'   # runs every 30 minutes
  workflow_dispatch:         # allows manual trigger

jobs:
  update-content:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Fetch AI Studio content
        run: |
          curl -L "https://aistudio.google.com/apps/a2037c87-a250-4569-842b-51db57b62e5d/export" -o content.json
          mkdir -p data
          mv content.json ./data/ai-content.json

      - name: Commit and push changes
        run: |
          git config --global user.name "AI Sync Bot"
          git config --global user.email "actions@github.com"
          git add .
          git commit -m "Auto-update AI Studio content"
          git push
